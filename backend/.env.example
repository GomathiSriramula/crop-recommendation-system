NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/soilwise
# At least 32 random characters (required in production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1d
FRONTEND_ORIGIN=http://localhost:5173
ML_API_URL=http://127.0.0.1:8000
# Optional shared secret; must match ML_API_KEY of the ML service.
ML_API_KEY=
ML_TIMEOUT_MS=20000
COUNTERFACTUAL_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Number of reverse proxies in front of the app (0 = none).
TRUST_PROXY=0
